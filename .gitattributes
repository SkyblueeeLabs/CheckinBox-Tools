# 统一行尾：源码/文档用 LF（避免 autocrlf=true 把 LF 转 CRLF 造成整文件 diff 噪音）
# 默认：文本文件入库统一 LF，检出也保持 LF
* text=auto eol=lf

# 明确指定
*.md   text eol=lf
*.rs   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.jsx  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.py   text eol=lf
*.sh   text eol=lf

# Windows 脚本保持 CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制，禁止行尾转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.exe  binary
*.dll  binary
*.pdf  binary
*.zip  binary
*.woff binary
*.woff2 binary
*.ttf  binary
