{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "聚合签到",
  "version": "0.1.0",
  "identifier": "com.skyblueee.agent-checkin-tools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "聚合签到",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
