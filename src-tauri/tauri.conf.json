{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CheckinBox",
  "version": "0.1.0",
  "identifier": "com.skyblueee.checkinbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CheckinBox",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "zh-CN"
        ]
      }
    },
    "shortDescription": "把散落在各 AI 编程工具里的每日积分签到收进一个窗口",
    "longDescription": "CheckinBox 把本机已登录的 AI 编程客户端（MiniMax Code / Qoder CN / WorkBuddy / 妙手）接进来：统一查看各账号积分、按平台活动刷新时刻自动签到、多账号切换客户端登录、签到流水与积分趋势。多账号凭据自动保鲜，不在客户端里的账号也照常签到。",
    "copyright": "仅供个人学习自用",
    "category": "DeveloperTool"
  }
}